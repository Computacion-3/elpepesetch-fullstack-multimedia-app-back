              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Entrada de biblioteca creada', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('libraryEntryId', body.id);",
                  "pm.test('La API devuelve el id de la entrada', function () { pm.expect(body.id).to.be.a('string'); });"
