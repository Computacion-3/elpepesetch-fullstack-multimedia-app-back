    {
      "name": "02 - Estadísticas",
      "item": [
        {
          "name": "GET /stats/me - estadísticas del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/stats/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Incluye agregados personales esperados', function () {",
                  "  pm.expect(body).to.have.property('entriesByType');",
                  "  pm.expect(body).to.have.property('entriesByStatus');",
                  "  pm.expect(body.topGenres).to.be.an('array');",
                  "  pm.expect(body.completedByMonth).to.be.an('array').with.lengthOf(12);",
                  "  pm.expect(body.averageRating).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /stats/global - permitido para ADMIN",
          "request": {
            "method": "GET",
            "header": [],
